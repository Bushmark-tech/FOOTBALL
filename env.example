# Football Predictor Pro - Production Environment Variables
# Copy this file to .env and update with your production values

# ========== REQUIRED SETTINGS ==========

# Django Settings (REQUIRED)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database Configuration (PostgreSQL - REQUIRED)
DATABASE_URL=postgresql://username:password@localhost:5432/football_predictor_prod

# Redis Configuration (REQUIRED)
REDIS_URL=redis://localhost:6379/1

# ========== SECURITY SETTINGS ==========

# HTTPS/SSL Settings
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ========== FASTAPI CONFIGURATION ==========

# FastAPI Service URL (REQUIRED for predictions)
FASTAPI_URL=http://localhost:8001
FASTAPI_TIMEOUT=30

# FastAPI Server Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_WORKERS=4

# ========== M-PESA PAYMENT SETTINGS ==========

# M-Pesa Credentials (Required if using payments)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=3040653  # Till Number (use CustomerBuyGoodsOnline) or Paybill (use CustomerPayBillOnline)
MPESA_PASSKEY=your-mpesa-passkey
MPESA_ENVIRONMENT=sandbox  # Change to 'production' for live payments

# ========== EMAIL CONFIGURATION ==========

# Email Settings (Optional but recommended)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@footballpredictor.com

# Admin Email
ADMIN_EMAIL=admin@yourdomain.com
SERVER_EMAIL=server@yourdomain.com

# ========== OPTIONAL SETTINGS ==========

# Rate Limiting
RATELIMIT_ENABLE=True

# Model Paths (if custom locations)
MODEL1_PATH=/app/models/model1.pkl
MODEL2_PATH=/app/models/model2.pkl

# Health Checks
HEALTH_CHECK_ENABLED=True

# Error Monitoring (Sentry)
SENTRY_DSN=https://your-sentry-dsn-url

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========== NOTES ==========
# 1. Never commit this file with real credentials to version control
# 2. All REQUIRED settings must be set for production deployment
# 3. Change all default passwords and keys
# 4. Use strong, unique SECRET_KEY (minimum 50 characters)
# 5. Ensure ALLOWED_HOSTS matches your actual domain names
